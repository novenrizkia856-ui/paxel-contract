# Placeholders only. Copy to .env and fill locally. Never commit real values.

# Deployer key. It becomes the registry admin. For anvil use one of the printed dev keys.
PRIVATE_KEY=

# Robinhood Chain mainnet. For a local run use RPC_URL=http://127.0.0.1:8545 and CHAIN_ID=31337.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
DEPLOY_NETWORK=mainnet
NETWORK_NAME="Robinhood Chain"
EXPLORER_BASE_URL=https://robinhoodchain.blockscout.com
